			"dependencies": [
				"jquery",
				"mediawiki.util"
			],
			"messages": []
		}
	},
	"ExtensionMessagesFiles": {
		"ExamplesAlias": "Examples.i18n.alias.php"
	},
	"SpecialPages": {
		"ExamplesHello": "MediaWiki\\Extension\\Examples\\SpecialHello"
